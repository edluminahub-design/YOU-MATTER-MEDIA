{
  "name": "you-matter-media",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing site for You Matter Media — creative strategy, branding, design and digital.",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server.mjs\"",
    "dev:client": "vite",
    "server": "node server.mjs",
    "build": "vite build",
    "build:static": "vite build --mode static && node scripts/package-static.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.4",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
